{
   "lsp": {
      "rust-analyzer": {
         "initialization_options": {
            "cargo": {
               "target": "avr-none",
               "extraEnv": {
                  "RUSTFLAGS": "-C target-cpu=atmega328p",
               },
            },
            "procMacro": {
               "enable": true,
            },
            "diagnostics": {},
            "check": {
               "allTargets": false,
            },
         },
      },
   },
}
